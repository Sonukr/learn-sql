# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Google AI Studio key for the tutor: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
GEMINI_MODEL=gemini-flash-latest

# Feedback → Supabase (run supabase/feedback.sql first). Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
